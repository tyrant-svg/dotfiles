[global]
    monitor             = 0
    follow              = mouse
    width               = 340
    height              = 120
    origin              = top-right
    offset              = 12x50
    scale               = 0
    notification_limit  = 5
    progress_bar        = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width   = 150
    progress_bar_max_width   = 300
    indicate_hidden     = yes
    transparency        = 15
    separator_height    = 1
    padding             = 12
    horizontal_padding  = 14
    text_icon_padding   = 0
    frame_width         = 1
    frame_color         = "#4b4739"
    gap_size            = 6
    separator_color     = frame
    sort                = yes
    idle_threshold      = 120
    font                = JetBrains Mono 11
    line_height         = 0
    markup              = full
    format              = "<b>%s</b>\n%b"
    alignment           = left
    vertical_alignment  = center
    show_age_threshold  = 60
    ellipsize           = middle
    ignore_newline      = no
    stack_duplicates    = true
    hide_duplicate_count = false
    show_indicators     = yes
    enable_recursive_icon_lookup = true
    icon_theme          = Papirus-Dark
    icon_position       = left
    min_icon_size       = 32
    max_icon_size       = 48
    sticky_history      = yes
    history_length      = 20
    browser             = /usr/bin/xdg-open
    always_run_script   = true
    title               = Dunst
    class               = Dunst
    corner_radius       = 10
    ignore_dbusclose    = false
    layer               = overlay
    force_xwayland      = false
    mouse_left_click    = close_current
    mouse_middle_click  = do_action, close_current
    mouse_right_click   = close_all

[urgency_low]
    background  = "#1e1b13cc"
    foreground  = "#cdc6b4"
    frame_color = "#ddc66e"
    timeout     = 4
    default_icon = dialog-information

[urgency_normal]
    background  = "#221f17ee"
    foreground  = "#e9e2d4"
    frame_color = "#ddc66e"
    timeout     = 6
    default_icon = dialog-information

[urgency_critical]
    background  = "#221f17ee"
    foreground  = "#e9e2d4"
    frame_color = "#ffb4ab"
    timeout     = 0
    default_icon = dialog-error
