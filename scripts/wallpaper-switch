marker_selected = { fg = "###ACCENT##",  bg = "###ACCENT##" }
marker_copied   = { fg = "#aad0b2", bg = "#aad0b2" }
marker_cut      = { fg = "#ffb4ab", bg = "#ffb4ab" }

tab_active   = { fg = "#16130b", bg = "###ACCENT##" }
tab_inactive = { fg = "#4b4739", bg = "#221f17" }
tab_width    = 1

border_symbol = "│"
border_style  = { fg = "#4b4739" }

[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "#4b4739", bg = "#4b4739" }

mode_normal = { fg = "#16130b", bg = "###ACCENT##",     bold = true }
mode_select = { fg = "#16130b", bg = "#aad0b2", bold = true }
mode_unset  = { fg = "#16130b", bg = "#ffb4ab", bold = true }

progress_label  = { fg = "#e9e2d4", bold = true }
progress_normal = { fg = "###ACCENT##",  bg = "#221f17" }
progress_error  = { fg = "#ffb4ab", bg = "#221f17" }

permissions_t = { fg = "###ACCENT_DIM##" }
permissions_r = { fg = "#aad0b2" }
permissions_w = { fg = "#ffb4ab" }
permissions_x = { fg = "###ACCENT##" }
permissions_s = { fg = "#4b4739" }

[input]
border   = { fg = "###ACCENT##" }
title    = {}
value    = {}
selected = { reversed = true }

[select]
