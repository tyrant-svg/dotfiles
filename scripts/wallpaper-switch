# ── Spicetify color.ini ───────────────────────────────────────────────────────
gen_spicetify_theme() {
    cat > ~/.config/spicetify/Themes/sleek_cyber/color.ini << 'EOF'
[Base]
text               = e9e2d4
subtext            = cdc6b4
sidebar-title      = ##ACCENT##
cover-shadow       = 16130b
nav-active-color   = ##ACCENT##
main-bg            = 16130b
sidebar-bg         = 1a1714
main-interface-bg  = 16130b
link               = ##ACCENT##
shadow             = 000000
selected-row       = 221f17
button             = ##ACCENT##
button-active      = ##ACCENT##
button-disabled    = 4b4739
tab-active         = ##ACCENT##
notification-error-bg = 1a1714
misc               = 4b4739
EOF
    _apply ~/.config/spicetify/Themes/sleek_cyber/color.ini
    spicetify apply &>/dev/null &
}

# ── GTK3 theme (Thunar + all GTK apps) ───────────────────────────────────────
gen_gtk_theme() {
    cat > ~/.config/gtk-3.0/colors.css << 'EOF'
/* sleek_cyber GTK3 colors — generated by wallpaper-switch */
@define-color borders_breeze #4b4739;
@define-color content_view_bg_breeze #16130b;
@define-color error_color_backdrop_breeze #ffb4ab;
@define-color error_color_breeze #ffb4ab;
@define-color insensitive_base_color_breeze #1a1714;
@define-color insensitive_base_fg_color_breeze #4b4739;
@define-color insensitive_bg_color_breeze #1a1714;
@define-color insensitive_borders_breeze #2d2a21;
@define-color insensitive_fg_color_breeze #4b4739;
@define-color link_color_breeze ###ACCENT##;
@define-color link_visited_color_breeze ###ACCENT_DIM##;
@define-color success_color_breeze #aad0b2;
@define-color theme_base_color_breeze #16130b;
@define-color theme_bg_color_breeze #1a1714;
@define-color theme_button_background_normal_breeze #221f17;
@define-color theme_button_decoration_focus_breeze ###ACCENT##;
@define-color theme_button_decoration_hover_breeze ###ACCENT##;
@define-color theme_button_foreground_active_breeze #16130b;
@define-color theme_button_foreground_normal_breeze #e9e2d4;
@define-color theme_fg_color_breeze #e9e2d4;
@define-color theme_header_background_breeze #1a1714;
@define-color theme_header_foreground_breeze #e9e2d4;
@define-color theme_hovering_selected_bg_color_breeze ###ACCENT##;
@define-color theme_selected_bg_color_breeze #2d2a21;
@define-color theme_selected_fg_color_breeze ###ACCENT##;
@define-color theme_text_color_breeze #e9e2d4;
@define-color theme_titlebar_background_breeze #1a1714;
@define-color theme_titlebar_foreground_breeze #e9e2d4;
@define-color theme_view_active_decoration_color_breeze ###ACCENT##;
@define-color theme_view_hover_decoration_color_breeze ###ACCENT##;
@define-color tooltip_background_breeze #221f17;
@define-color tooltip_border_breeze #4b4739;
@define-color tooltip_text_breeze #e9e2d4;
@define-color unfocused_borders_breeze #4b4739;
EOF
    _apply ~/.config/gtk-3.0/colors.css

    cat > ~/.config/gtk-3.0/gtk.css << 'EOF'
@import 'colors.css';

* { font-family: "JetBrains Mono", monospace; }

*:selected, *:selected:focus {
    background-color: #2d2a21;
    color: ###ACCENT##;
}

scrollbar slider { background-color: #4b4739; border-radius: 3px; min-width: 4px; min-height: 4px; }
scrollbar slider:hover { background-color: #5c5748; }
scrollbar { background-color: transparent; }

.sidebar, .sidebar *, placessidebar, placessidebar * {
    background-color: #1a1714; color: #cdc6b4;
}
placessidebar row:hover { background-color: #221f17; color: #e9e2d4; }
placessidebar row:selected, placessidebar row:selected * {
    background-color: #2d2a21; color: ###ACCENT##;
}

headerbar, .header-bar {
    background-color: #1a1714; border-bottom: 1px solid #4b4739; color: #e9e2d4;
}
headerbar button { color: #cdc6b4; }
headerbar button:hover { color: ###ACCENT##; }

menu, .context-menu { background-color: #221f17; border: 1px solid #4b4739; color: #e9e2d4; }
menuitem:hover { background-color: #2d2a21; color: ###ACCENT##; }

button { background-color: #221f17; border: 1px solid #4b4739; color: #cdc6b4; }
button:hover { background-color: #2d2a21; color: #e9e2d4; border-color: ###ACCENT##; }

entry { background-color: #221f17; border: 1px solid #4b4739; color: #e9e2d4; }
entry:focus { border-color: ###ACCENT##; }
EOF
    _apply ~/.config/gtk-3.0/gtk.css
}

# ── Run all generators ─────────────────────────────────────────────────────────
gen_hypr_colors
gen_kitty_theme
gen_waybar_css
gen_rofi_theme
gen_eww_scss
gen_yazi_theme
patch_dunst
gen_btop_theme
gen_tmux_theme
gen_vesktop_theme
gen_spicetify_theme
gen_gtk_theme

# ── Reload services ───────────────────────────────────────────────────────────
hyprctl reload

pkill waybar
sleep 0.3
WAYLAND_DISPLAY=wayland-1 waybar &>/dev/null &

pkill dunst
sleep 0.1
dunst &>/dev/null &

# eww: reload scss only (no floating windows)
eww reload 2>/dev/null || true

# kitty live-reload (affects new windows immediately, open windows on next launch)
kitty @ set-colors -a --configured 2>/dev/null

wait  # wait for awww wallpaper fade to finish
notify-send -t 3000 "Wallpaper" "$(basename "$WALL")  #$ACCENT"
