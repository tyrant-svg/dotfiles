    bg:         rgba(22,  19,  11,  0.94);
    bg-alt:     rgba(34,  31,  23,  0.97);
    bg-hover:   rgba(34,  31,  23,  0.60);
    border-col: rgba(75,  71,  57,  0.7);
    accent:     ###ACCENT##;
    accent-dim: ###ACCENT_DIM##;
    fg:         #e9e2d4;
    fg-muted:   #cdc6b4;
    urgent:     #ffb4ab;
    background-color: transparent;
    text-color:       @fg;
}

window {
    width: 480px; border-radius: 4px;
    border: 1px; border-color: @border-col;
    background-color: @bg; padding: 10px;
}
mainbox { background-color: transparent; spacing: 6px; }
inputbar {
    background-color: @bg-alt; border-radius: 2px;
    border: 1px; border-color: @border-col;
    padding: 7px 12px; spacing: 8px;
    children: [ prompt, entry ];
}
