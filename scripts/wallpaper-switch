cand            = { fg = "###ACCENT##" }
rest            = { fg = "#cdc6b4" }
desc            = { fg = "###ACCENT_DIM##" }
separator       = "  "
separator_style = { fg = "#4b4739" }

[help]
on      = { fg = "###ACCENT##" }
exec    = { fg = "###ACCENT_DIM##" }
desc    = { fg = "#cdc6b4" }
hovered = { bg = "#221f17", bold = true }
footer  = { fg = "#16130b", bg = "#cdc6b4" }

[filetype]
rules = [
    { mime = "image/*",                         fg = "###ACCENT_DIM##" },
    { mime = "video/*",                         fg = "###ACCENT##" },
    { mime = "audio/*",                         fg = "###ACCENT##" },
    { mime = "application/zip",                 fg = "#ffb4ab" },
    { mime = "application/gzip",               fg = "#ffb4ab" },
    { mime = "application/x-tar",              fg = "#ffb4ab" },
    { mime = "application/x-bzip",             fg = "#ffb4ab" },
    { mime = "application/x-bzip2",            fg = "#ffb4ab" },
    { mime = "application/x-7z-compressed",    fg = "#ffb4ab" },
    { mime = "application/x-rar",              fg = "#ffb4ab" },
    { mime = "application/pdf",                fg = "#aad0b2" },
    { mime = "text/*",                         fg = "#e9e2d4" },
    { name = "*.rs",   fg = "#d2c6a1" },
    { name = "*.R",    fg = "###ACCENT##" },
    { name = "*.py",   fg = "#d2c6a1" },
    { name = "*.js",   fg = "#d2c6a1" },
    { name = "*.json", fg = "###ACCENT_DIM##" },
    { name = "*.toml", fg = "###ACCENT_DIM##" },
    { name = "*.md",   fg = "#e9e2d4" },
    { name = "*",      fg = "#e9e2d4" },
    { name = "*/",     fg = "###ACCENT##" },
]
EOF
    _apply ~/.config/yazi/theme.toml
}

# ── Dunst accent (sed in place) ───────────────────────────────────────────────
patch_dunst() {
    sed -i \
        "s/frame_color = \"#[0-9a-fA-F]\{6\}\"/frame_color = \"#$ACCENT\"/g" \
        ~/.config/dunst/dunstrc
    # only patch normal urgency frame; critical stays #ffb4ab
    # restore critical after broad replace
    sed -i \
        '/\[urgency_critical\]/,/^$/ s/frame_color = "#[0-9a-fA-F]\{6\}"/frame_color = "#ffb4ab"/' \
        ~/.config/dunst/dunstrc
}

