#!/usr/bin/env bash
# wallpaper-switch — set wallpaper, extract accent color, update entire rice
# Usage:
#   wallpaper-switch --random        pick random from ~/Pictures/Wallpapers/
#   wallpaper-switch /path/to/img    specific wallpaper
# Bind: Super+backslash

WALL_DIR="$HOME/Pictures/Wallpapers"
RICE_DIR="$HOME/.config/rice"
mkdir -p "$RICE_DIR"

# ── Pick wallpaper ─────────────────────────────────────────────────────────────
if [[ "$1" == "--random" ]] || [[ -z "$1" ]]; then
    WALL="$(find "$WALL_DIR" -maxdepth 3 -type f \
        \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) \
        | shuf -n 1)"
else
    WALL="$1"
fi

if [[ -z "$WALL" || ! -f "$WALL" ]]; then
    notify-send -t 4000 "wallpaper-switch" "No wallpaper found in $WALL_DIR"
    exit 1
fi

# ── Set wallpaper immediately (don't wait for color extraction) ────────────────
awww img "$WALL" --transition-type fade --transition-duration 1 &
# Update symlink for hyprlock background
ln -sf "$WALL" "$WALL_DIR/.current"

# ── Extract accent colors via matugen (Material You palette) ──────────────────
_matugen_color() {
    matugen image "$WALL" --json hex --prefer saturation 2>/dev/null \
        | python3 -c "
import sys, json
d = json.load(sys.stdin)
c = d.get('colors', {}).get('$1', {}).get('dark', {}).get('color', '')
print(c.lstrip('#'))
" 2>/dev/null
}

ACCENT="$(_matugen_color primary)"
[[ -z "$ACCENT" ]] && ACCENT="$(python3 ~/.local/bin/extract-accent "$WALL" 2>/dev/null)"
[[ -z "$ACCENT" ]] && ACCENT="$(cat "$RICE_DIR/accent" 2>/dev/null || echo "ddc66e")"
echo "$ACCENT" > "$RICE_DIR/accent"

ACCENT_DIM="$(_matugen_color secondary)"
[[ -z "$ACCENT_DIM" ]] && ACCENT_DIM="d2c6a1"

ACCENT_TERTIARY="$(_matugen_color tertiary)"
[[ -z "$ACCENT_TERTIARY" ]] && ACCENT_TERTIARY="aad0b2"

# ── Config regenerators ────────────────────────────────────────────────────────
# Each function writes a config file with ##ACCENT## / ##ACCENT_DIM## placeholders
# then substitutes the real values. Base colors (bg, fg, border) never change.

_apply() {
    # _apply <file>  —  replaces placeholders with real accent values in-place
    sed -i \
        "s/##ACCENT##/$ACCENT/g; s/##ACCENT_DIM##/$ACCENT_DIM/g" \
        "$1"
}

# ── Hyprland colors.conf ──────────────────────────────────────────────────────
gen_hypr_colors() {
    cat > ~/.config/hypr/colors.conf << 'EOF'
# Generated by wallpaper-switch — do not edit manually
$accent_border     = rgba(##ACCENT##ff)
$accent_border_dim = rgba(##ACCENT_DIM##aa)
EOF
    _apply ~/.config/hypr/colors.conf
    # Patch hyprlock accent colors in-place
    sed -i \
        "s/check_color   = rgb([0-9a-fA-F]*)/check_color   = rgb($ACCENT)/g; \
         s/capslock_color = rgb([0-9a-fA-F]*)/capslock_color = rgb($ACCENT)/g; \
         s/outer_color    = rgba([0-9a-fA-F]*)/outer_color    = rgba(${ACCENT}ff)/g" \
        ~/.config/hypr/hyprlock.conf 2>/dev/null || true
}

# ── Kitty theme.conf ──────────────────────────────────────────────────────────
gen_kitty_theme() {
    cat > ~/.config/kitty/theme.conf << 'EOF'
# sleek_cyber — accent extracted from wallpaper
background        #16130b
foreground        #e9e2d4
cursor            ###ACCENT##
cursor_text_color #16130b

selection_background ###ACCENT##
selection_foreground #16130b

# Normal (0-7)
color0   #1a1714
color1   #ff5555
color2   #aad0b2
color3   ###ACCENT##
color4   ###ACCENT_DIM##
color5   #c8956a
color6   ###ACCENT_DIM##
color7   #e9e2d4

# Bright (8-15)
color8   #4b4739
color9   #ff7070
color10  #c5e6cc
color11  ###ACCENT##
color12  ###ACCENT_DIM##
color13  #e0aa88
color14  ###ACCENT_DIM##
color15  #ffffff

url_color ###ACCENT_DIM##
EOF
    _apply ~/.config/kitty/theme.conf
}

# ── Waybar style.css ──────────────────────────────────────────────────────────
gen_waybar_css() {
    cat > ~/.config/waybar/style.css << 'EOF'
/* Palette — base fixed, accent from wallpaper
   bg:       #16130b  surface:  #221f17  fg:       #e9e2d4
   fg_muted: #cdc6b4  border:   #4b4739  green:    #aad0b2
   accent:   ###ACCENT##   accent_dim: ###ACCENT_DIM##
*/

* {
    font-family: "JetBrains Mono Nerd Font", "JetBrains Mono", monospace;
    font-size: 13px;
    border: none;
    border-radius: 0;
    min-height: 0;
}

window#waybar {
    background-color: rgba(22, 19, 11, 0.82);
    color: #e9e2d4;
    border-radius: 12px;
    border: 1px solid rgba(75, 71, 57, 0.6);
    border-top: 2px solid rgba(##ACCENT##, 0.6);
    transition: background-color 0.3s ease;
}

.modules-left, .modules-center, .modules-right {
    padding: 0 8px;
}

#workspaces { margin: 4px 4px; }

#workspaces button {
    padding: 0 6px;
    color: #cdc6b4;
    background-color: rgba(75, 71, 57, 0.4);
    border-radius: 6px;
    margin: 0 2px;
    min-width: 26px;
    font-size: 11px;
    transition: all 0.2s ease;
}

#workspaces button:hover {
    background-color: rgba(##ACCENT##, 0.2);
    color: #e9e2d4;
}

#workspaces button.active {
    background-color: rgba(##ACCENT##, 0.22);
    color: ###ACCENT##;
    border: 1px solid rgba(##ACCENT##, 0.55);
}

#workspaces button.urgent {
    background-color: rgba(255, 180, 171, 0.3);
    color: #ffb4ab;
}

#window {
    color: #4b4739;
    padding: 0 12px;
    font-size: 12px;
}

#custom-music {
    color: #cdc6b4;
    font-size: 12px;
    padding: 0 12px;
    border-right: 1px solid rgba(75, 71, 57, 0.5);
    margin-right: 4px;
}

#custom-music:hover { color: ###ACCENT##; }

#clock {
    color: #e9e2d4;
    font-size: 13px;
    font-weight: bold;
    padding: 0 12px;
}

#cpu, #memory, #network, #pulseaudio, #tray, #custom-power {
    padding: 0 10px;
    margin: 4px 2px;
    background-color: rgba(75, 71, 57, 0.3);
    border-radius: 6px;
    color: #cdc6b4;
}

#temperature          { color: #aad0b2; }
#temperature.critical { color: #ffb4ab; background-color: rgba(255, 180, 171, 0.12); }

#disk { color: #cdc6b4; }

#cpu            { color: #aad0b2; }
#cpu.warning    { color: ###ACCENT##; }
#cpu.critical   { color: #ffb4ab; }

#memory         { color: ###ACCENT_DIM##; }
#memory.warning { color: ###ACCENT##; }
#memory.critical { color: #ffb4ab; }

#network        { color: #cdc6b4; }
#network.disconnected { color: #4b4739; }

#pulseaudio       { color: ###ACCENT##; }
#pulseaudio.muted { color: #4b4739; }

#tray { padding: 0 8px; }

#custom-power {
    color: #cdc6b4;
    font-size: 15px;
    padding: 0 12px;
}

#custom-power:hover {
    color: #ffb4ab;
    background-color: rgba(255, 180, 171, 0.15);
}

tooltip {
    background-color: rgba(22, 19, 11, 0.95);
    border: 1px solid rgba(75, 71, 57, 0.8);
    border-radius: 8px;
    color: #e9e2d4;
}
EOF
    # border-top uses CSS rgba() — need comma-separated r,g,b
    local R=$((16#${ACCENT:0:2}))
    local G=$((16#${ACCENT:2:2}))
    local B=$((16#${ACCENT:4:2}))
    local R2=$((16#${ACCENT_DIM:0:2}))
    local G2=$((16#${ACCENT_DIM:2:2}))
    local B2=$((16#${ACCENT_DIM:4:2}))
    sed -i \
        "s/rgba(##ACCENT##, 0.6)/rgba($R, $G, $B, 0.6)/g" \
        ~/.config/waybar/style.css
    sed -i \
        "s/rgba(##ACCENT##, 0.2)/rgba($R, $G, $B, 0.2)/g" \
        ~/.config/waybar/style.css
    sed -i \
        "s/rgba(##ACCENT##, 0.22)/rgba($R, $G, $B, 0.22)/g" \
        ~/.config/waybar/style.css
    sed -i \
        "s/rgba(##ACCENT##, 0.55)/rgba($R, $G, $B, 0.55)/g" \
        ~/.config/waybar/style.css
    # remaining ## placeholders → hex values
    _apply ~/.config/waybar/style.css
}

# ── Rofi theme.rasi ───────────────────────────────────────────────────────────
gen_rofi_theme() {
    cat > ~/.config/rofi/theme.rasi << 'EOF'
