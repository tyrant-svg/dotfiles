# ── tmux colors.conf (separate from behavior settings) ───────────────────────
gen_tmux_theme() {
    cat > ~/.config/tmux/colors.conf << 'EOF'
# Generated by wallpaper-switch — do not edit manually
set -g status-style    "bg=#16130b,fg=#cdc6b4"
set -g status-left     "#[fg=###ACCENT##,bold] #S #[fg=#4b4739,nobold]│ "
set -g status-right    "#[fg=#4b4739]│ #[fg=#cdc6b4]%a %d %H:%M #[fg=#4b4739]│ #[fg=###ACCENT##]#h "
set -g window-status-current-format  "#[fg=#16130b,bg=###ACCENT##,bold] #I:#W "
set -g window-status-format          "#[fg=#4b4739] #I:#W "
set -g pane-active-border-style      "fg=###ACCENT##"
set -g pane-border-style             "fg=#4b4739"
set -g message-style                 "bg=#221f17,fg=###ACCENT##"
set -g message-command-style         "bg=#221f17,fg=#cdc6b4"
set -g mode-style                    "bg=###ACCENT##,fg=#16130b"
EOF
    _apply ~/.config/tmux/colors.conf
    # live reload if tmux is running
    tmux source-file ~/.config/tmux/colors.conf 2>/dev/null || true
}

# ── Vesktop CSS ───────────────────────────────────────────────────────────────
gen_vesktop_theme() {
    local R=$((16#${ACCENT:0:2}))
    local G=$((16#${ACCENT:2:2}))
    local B=$((16#${ACCENT:4:2}))
    local Rd=$((16#${ACCENT_DIM:0:2}))
    local Gd=$((16#${ACCENT_DIM:2:2}))
    local Bd=$((16#${ACCENT_DIM:4:2}))
    cat > ~/.config/vesktop/themes/sleek_cyber.theme.css << 'EOF'
/**
 * @name sleek_cyber
 * @description Terminal-style Discord — transparent panels, accent from wallpaper
 */

/* ── Variables ───────────────────────────────────────────────────────────── */
:root {
    --background-primary:            rgba(22, 19, 11, 0.55);
    --background-secondary:          rgba(26, 23, 20, 0.60);
    --background-secondary-alt:      rgba(34, 31, 23, 0.65);
    --background-tertiary:           rgba(22, 19, 11, 0.45);
    --background-accent:             rgba(##ACCENT##r, ##ACCENT##g, ##ACCENT##b, 0.10);
    --background-floating:           rgba(26, 23, 20, 0.85);
    --background-modifier-hover:     rgba(##ACCENT##r, ##ACCENT##g, ##ACCENT##b, 0.05);
    --background-modifier-active:    rgba(##ACCENT##r, ##ACCENT##g, ##ACCENT##b, 0.10);
    --background-modifier-selected:  rgba(##ACCENT##r, ##ACCENT##g, ##ACCENT##b, 0.12);
    --deprecated-card-bg:            rgba(34, 31, 23, 0.60);
    --channeltextarea-background:    rgba(34, 31, 23, 0.70);
    --text-normal:      #e9e2d4;
    --text-muted:       #4b4739;
    --text-link:        ###ACCENT##;
    --text-positive:    #aad0b2;
    --text-warning:     ###ACCENT##;
    --text-danger:      #ffb4ab;
    --header-primary:   #e9e2d4;
    --header-secondary: #cdc6b4;
    --interactive-normal:  #cdc6b4;
    --interactive-hover:   #e9e2d4;
    --interactive-active:  ###ACCENT##;
    --interactive-muted:   #4b4739;
    --channel-icon:        #4b4739;
    --focus-primary:       rgba(##ACCENT##r, ##ACCENT##g, ##ACCENT##b, 0.4);
    --brand-experiment:     ###ACCENT##;
    --brand-experiment-500: ###ACCENT##;
    --brand-experiment-560: ###ACCENT_DIM##;
    --mention-background: rgba(##ACCENT##r, ##ACCENT##g, ##ACCENT##b, 0.08);
    --mention-foreground: ###ACCENT##;
