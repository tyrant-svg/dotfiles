{
    "layer": "top",
    "output": "DP-2",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "exclusive": true,
    "passthrough": false,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "custom/music",
        "clock"
    ],

    "modules-right": [
        "temperature",
        "cpu",
        "memory",
        "disk#vol2",
        "network",
        "pulseaudio",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1":  "1:dev",
            "2":  "2:web",
            "3":  "3:ref",
            "4":  "4:media",
            "5":  "5:util",
            "6":  "6",
            "7":  "7",
            "8":  "8:tv",
            "9":  "9",
            "10": "10"
        },
        "on-scroll-up":   "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "on-click": "activate",
        "persistent-workspaces": {
            "DP-2":    [1, 2, 3],
            "DP-3":    [4, 5],
            "HDMI-A-1":[6, 7],
            "DP-1":    [8, 9]
        }
    },

    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": " $1",
            "(.*) - kitty": " $1",
            "": ""
        }
    },

    "custom/music": {
        "format": "  {}",
        "exec": "playerctl metadata --format '{{artist}} — {{title}}' 2>/dev/null",
        "exec-if": "playerctl status 2>/dev/null | grep -qv Stopped",
        "interval": 2,
        "max-length": 50,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "escape": true,
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %B %d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 10
    },

    "network": {
        "format-wifi":        " {signalStrength}%",
        "format-ethernet":    " eth",
        "format-disconnected": "󰌙 off",
        "tooltip-format-wifi":     "{essid}  {signalStrength}%  {ipaddr}",
        "tooltip-format-ethernet": "{ipaddr}",
        "interval": 10
    },

    "temperature": {
        "critical-threshold": 85,
        "format": " {temperatureC}°",
        "format-critical": " {temperatureC}°",
        "interval": 5,
        "tooltip": false
    },

    "disk#vol2": {
        "interval": 60,
        "format": "󰋊 {percentage_used}%",
        "path": "/mnt/vol_ii",
        "tooltip-format": "Vol_II  {used} / {total}",
        "tooltip": true
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "format": "",
        "on-click": "rofi -show power-menu -modi power-menu:~/.config/rofi/power-menu.sh -theme ~/.config/rofi/theme.rasi",
        "tooltip": false
    }
}
