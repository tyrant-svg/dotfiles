{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/gh0st/Pictures/gifs/Discord Licking GIF by kaomoji.gif",
    "width": 38,
    "height": 22,
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " → ",
    "color": {
      "separator": "yellow",
      "keys": "yellow",
      "title": "white"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "format": "{#33}{user-name}{#}{#90}@{#}{#37}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{#90}────────────────────────────{#}"
    },
    "break",
    {"type": "os",       "key": "{#33}  OS{#}       ", "keyWidth": 12},
    {"type": "kernel",   "key": "{#33}  Kernel{#}   ", "keyWidth": 12},
    {"type": "wm",       "key": "{#33}  WM{#}       ", "keyWidth": 12},
    {"type": "terminal", "key": "{#33}  Term{#}     ", "keyWidth": 12},
    {"type": "shell",    "key": "{#33}  Shell{#}    ", "keyWidth": 12},
    {"type": "uptime",   "key": "{#33}  Uptime{#}   ", "keyWidth": 12},
    {"type": "packages", "key": "{#33}  Pkgs{#}     ", "keyWidth": 12},
    "break",
    {"type": "cpu",    "key": "{#37}  CPU{#}      ", "keyWidth": 12},
    {"type": "gpu",    "key": "{#37}  GPU{#}      ", "keyWidth": 12},
    {"type": "memory", "key": "{#37}  RAM{#}      ", "keyWidth": 12},
    {"type": "disk",   "key": "{#37}  Root{#}     ", "keyWidth": 12},
    {
      "type": "disk",
      "key": "{#37}  Vol_II{#}   ",
      "keyWidth": 12,
      "folders": "/mnt/vol_ii"
    },
    "break",
    {"type": "colors", "symbol": "circle", "paddingLeft": 1}
  ]
}
